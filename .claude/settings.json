{
  "$schema": "https://docs.claude.com/schemas/claude-settings.schema.json",

  "model": "claude-sonnet-4-20250514",
  "maxTokens": 8192,
  "defaultSubagentModel": "sonnet",

  "permissions": {
    "allow": [
      "Read(.claude/**)",
      "Read(docs/**)",
      "Read(examples/**)",
      "Read(scripts/**)",
      "Read(tests/**)",
      "Read(README.md)",
      "Read(CLAUDE.md)",
      "Read(ARCHITECTURE.md)",
      "Read(ANALYSIS.md)",
      "Read(DESIGN_PHILOSOPHY.md)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(tree *)",
      "Bash(cat *)",
      "Bash(python scripts/health_check.py)",
      "Bash(python scripts/validate_framework.py *)"
    ],

    "ask": [
      "Write(.claude/**)",
      "Write(docs/**)",
      "Write(examples/**)",
      "Write(scripts/**)",
      "Edit(.claude/**)",
      "Edit(docs/**)",
      "Edit(examples/**)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(python *)",
      "Bash(npm *)",
      "Bash(pip *)"
    ],

    "deny": [
      "Read(**/.env*)",
      "Read(**/secrets/**)",
      "Read(**/*credentials*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Write(**/.env*)",
      "Write(**/secrets/**)",
      "Bash(rm -rf*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(sudo*)",
      "Bash(chmod 777*)",
      "WebFetch(*)"
    ]
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write(**/*.md)|Edit(**/*.md)",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[MyClaude] Markdown file modified: $FILE_PATH\" >> .claude/logs/audit.log",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write(.claude/**)|Edit(.claude/**)",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[MyClaude] Framework file modified: $FILE_PATH\" >> .claude/logs/audit.log",
            "timeout": 5
          }
        ]
      }
    ],

    "PreToolUse": [
      {
        "matcher": "Write(.claude/skills/**)|Write(.claude/agents/**)",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[MyClaude] Validating framework component: $FILE_PATH\"",
            "timeout": 5
          }
        ]
      }
    ]
  },

  "env": {
    "MYCLAUDE_VERSION": "1.0.0",
    "MYCLAUDE_QUALITY_GATE_THRESHOLD": "0.7",
    "BASH_DEFAULT_TIMEOUT_MS": "30000"
  },

  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true
  },

  "telemetry": {
    "enabled": false
  }
}
