# MyClaude Framework .gitignore

# Local settings (personal preferences)
.claude/settings.local.json

# API keys and secrets
.env
.env.*
*.key
*.pem
secrets/
credentials.json

# Logs
.claude/logs/*.log
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Temporary files
*.tmp
*.bak
*.backup
temp/
tmp/

# OS
Thumbs.db
Desktop.ini

# Claude Code specific
.claude/.session*
.claude/.checkpoint*
